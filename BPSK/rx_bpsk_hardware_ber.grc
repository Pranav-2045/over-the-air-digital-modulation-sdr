- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport time\nimport\
      \ os\nimport inspect\n\nclass blk(gr.sync_block):\n    \"\"\"DBPSK BER & SNR\
      \ Calculator & CSV Logger\"\"\"\n    def __init__(self):\n        gr.sync_block.__init__(\n\
      \            self,\n            name='BER & SNR Calculator',\n            in_sig=[np.uint8,\
      \ np.complex64],\n            out_sig=[np.uint8]\n        )\n        # BPSK\
      \ preamble: same 11-symbol sequence as TX (values 0 or 1)\n        self.preamble\
      \ = np.array([1, 1, 1, 0, 0, 0, 1, 0, 0, 1, 0], dtype=np.uint8)\n        np.random.seed(42)\n\
      \        # BPSK payload reference: 989 bits (0 or 1)\n        self.payload_ref\
      \ = np.random.randint(0, 2, size=989, dtype=np.uint8)\n        \n        self.buffer\
      \ = np.array([], dtype=np.uint8)\n        self.total_bits = 0\n        self.total_errors\
      \ = 0\n        self.frame_count = 0\n        self.printed_debug = False\n  \
      \  \n        # Real-time SNR Estimation (Exponential Moving Average)\n     \
      \   self.avg_signal_power = 1.0\n        self.avg_noise_power = 0.01\n     \
      \   self.snr_db = 0.0\n    \n        # Absolute path for CSV file so it writes\
      \ next to the script\n        dir_path = os.path.dirname(os.path.abspath(__file__))\
      \ if '__file__' in locals() else '.'\n        self.csv_path = os.path.join(dir_path,\
      \ 'ber_bpsk_log.csv')\n        self.csv_file = open(self.csv_path, 'w')\n  \
      \      self.csv_file.write(\"timestamp,frame,total_bits,total_errors,ber,snr_db\\\
      n\")\n        self.csv_file.flush()\n\n        # Self-contained GUI Label Injection\
      \ via Stack Frames\n        self.top_block = None\n        self.ber_label =\
      \ None\n        self.gui_timer = None\n    \n        for frame_info in inspect.stack():\n\
      \            frame = frame_info.frame\n            if 'self' in frame.f_locals:\n\
      \                val = frame.f_locals['self']\n                if hasattr(val,\
      \ 'top_grid_layout'):\n                    self.top_block = val\n          \
      \          break\n                    \n        if self.top_block:\n       \
      \     try:\n                from PyQt5.QtWidgets import QLabel\n           \
      \     from PyQt5.QtCore import QTimer\n                \n                self.ber_label\
      \ = QLabel(\"Total Bits: 0 | Errors: 0 | BER: 0.00e+00 | SNR: 0.0 dB\")\n  \
      \              self.ber_label.setStyleSheet(\"font-size: 16px; font-weight:\
      \ bold; color: blue; padding: 10px;\")\n                self.top_block.top_grid_layout.addWidget(self.ber_label,\
      \ 0, 0, 1, 2)\n                \n                self.gui_timer = QTimer()\n\
      \                self.gui_timer.setInterval(200)\n                self.gui_timer.timeout.connect(self.update_gui)\n\
      \                self.gui_timer.start()\n                print(f\"[BER] Successfully\
      \ injected GUI label and timer. CSV logging to: {self.csv_path}\")\n       \
      \     except Exception as e:\n                print(f\"[BER] Failed to initialize\
      \ GUI components: {e}\")\n\n    def update_gui(self):\n        if self.ber_label:\n\
      \            bits = self.total_bits\n            errs = self.total_errors\n\
      \            ber = errs / bits if bits > 0 else 0\n            snr = self.snr_db\n\
      \            self.ber_label.setText(f\"Total Bits: {bits:,} | Errors: {errs:,}\
      \ | BER: {ber:.2e} | SNR: {snr:.1f} dB\")\n\n    def work(self, input_items,\
      \ output_items):\n        in_bits = input_items[0]\n        in_iq = input_items[1]\n\
      \        out = output_items[0]\n        \n        n_samps = min(len(in_bits),\
      \ len(in_iq))\n        if n_samps == 0:\n            return 0\n            \n\
      \        # 1. Update Real-Time SNR Estimate from IQ samples\n        iq_samps\
      \ = in_iq[:n_samps]\n        reals = iq_samps.real\n        sliced = np.where(reals\
      \ >= 0, 1.0 + 0j, -1.0 + 0j).astype(np.complex64)\n        \n        noise =\
      \ iq_samps - sliced\n        noise_p = np.mean(np.abs(noise)**2)\n        signal_p\
      \ = np.mean(np.abs(sliced)**2)\n        \n        alpha_ema = 0.05\n       \
      \ self.avg_signal_power = (1.0 - alpha_ema) * self.avg_signal_power + alpha_ema\
      \ * signal_p\n        self.avg_noise_power = (1.0 - alpha_ema) * self.avg_noise_power\
      \ + alpha_ema * noise_p\n        \n        if self.avg_noise_power > 0:\n  \
      \          self.snr_db = float(10.0 * np.log10(self.avg_signal_power / self.avg_noise_power))\n\
      \        else:\n            self.snr_db = 0.0\n\n        # 2. Robust Frame Sync\
      \ & BER Calculation\n        data_bits = in_bits[:n_samps]\n        data = np.concatenate([self.buffer,\
      \ data_bits])\n        \n        idx = 0\n        while idx + 1000 <= len(data):\n\
      \            # Check 11-bit preamble at current idx\n            window = data[idx\
      \ : idx + 11]\n            mismatches = int(np.sum(window != self.preamble))\n\
      \            \n            if mismatches <= 1:\n                # Preamble matched!\
      \ Process entire 1000-bit frame\n                rx_pay = data[idx + 11 : idx\
      \ + 1000]\n                errors = int(np.sum(rx_pay ^ self.payload_ref))\n\
      \                self.total_errors += errors\n                self.total_bits\
      \ += 989\n                self.frame_count += 1\n                \n        \
      \        if self.frame_count % 50 == 0:\n                    ber = self.total_errors\
      \ / self.total_bits if self.total_bits > 0 else 0\n                    print(f\"\
      [BER] Frame: {self.frame_count} | Total Bits: {self.total_bits} | Errors: {self.total_errors}\
      \ | BER: {ber:.2e} | SNR: {self.snr_db:.1f} dB\")\n                self.csv_file.write(f\"\
      {time.time()},{self.frame_count},{self.total_bits},{self.total_errors},{self.total_errors/self.total_bits:.2e},{self.snr_db:.2f}\\\
      n\")\n                self.csv_file.flush()\n                \n            \
      \    # Jump forward by full packet length (1000 bits)\n                idx +=\
      \ 1000\n            else:\n                # Slide window by 1 bit\n       \
      \         idx += 1\n                \n        self.buffer = data[idx:]\n   \
      \         \n        out[:n_samps] = data_bits\n        return n_samps\n\n  \
      \  def stop(self):\n        if hasattr(self, 'gui_timer') and self.gui_timer:\n\
      \            self.gui_timer.stop()\n        if hasattr(self, 'csv_file') and\
      \ self.csv_file:\n            self.csv_file.close()\n        return True\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('BER & SNR Calculator', 'blk', [], [('0', 'byte', 1), ('1', 'complex',
      1)], [('0', 'byte', 1)], 'DBPSK BER & SNR Calculator & CSV Logger', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1640, 200.0]
    rotation: 0
    state: true

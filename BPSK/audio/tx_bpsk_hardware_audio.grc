options:
  parameters:
    author: JaganMohan
    catch_exceptions: 'True'
    category: Custom
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: BPSK hardware Audio transmitter using USRP B210
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: tx_bpsk_hardware_audio
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: BPSK Audio Hardware Transmitter (USRP B210)
    window_size: 2000,2000
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 16.0]
    rotation: 0
    state: enabled

blocks:
- name: Alpha
  id: variable
  parameters:
    comment: ''
    value: '0.2'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [416, 4.0]
    rotation: 0
    state: enabled
- name: bpsk_const
  id: variable_constellation
  parameters:
    comment: 'BPSK: 2 points on real axis, 1 bit/symbol'
    const_points: '[-1+0j, 1+0j]'
    dims: '1'
    normalization: digital.constellation.AMPLITUDE_NORMALIZATION
    npwr: '1.0'
    precision: '8'
    rot_sym: '2'
    soft_dec_lut: None
    sym_map: '[0, 1]'
    type: bpsk
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1184, 12.0]
    rotation: 0
    state: true
- name: center_freq
  id: variable
  parameters:
    comment: ''
    value: '2850000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [700, 16.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '500000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [216, 4.0]
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: ''
    value: '10'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [328, 4.0]
    rotation: 0
    state: enabled
- name: tx_gain
  id: variable
  parameters:
    comment: ''
    value: '42'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [820, 16.0]
    rotation: 0
    state: enabled
- name: blocks_wavfile_source_0
  id: blocks_wavfile_source
  parameters:
    affinity: ''
    alias: ''
    comment: Input 8kHz 16-bit Mono WAV audio file
    file: C:\Users\jagan\Downloads\voice-telephony-8khz.wav
    maxoutbuf: '0'
    minoutbuf: '0'
    nchan: '1'
    repeat: 'True'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [24, 212.0]
    rotation: 0
    state: enabled
- name: digital_constellation_modulator_0
  id: digital_constellation_modulator
  parameters:
    affinity: ''
    alias: ''
    comment: Maps bytes to BPSK symbols with differential encoding & RRC shaping
    constellation: bpsk_const
    differential: 'True'
    excess_bw: Alpha
    log: 'False'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_symbol: sps
    truncate: 'False'
    verbose: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [576, 220.0]
    rotation: 0
    state: enabled
- name: epy_block_audio_framer
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport pycodec2\n\n\
      def encode_nibble(nibble):\n    d0 = (nibble >> 0) & 1\n    d1 = (nibble >>\
      \ 1) & 1\n    d2 = (nibble >> 2) & 1\n    d3 = (nibble >> 3) & 1\n    p0 = d0\
      \ ^ d1 ^ d3\n    p1 = d0 ^ d2 ^ d3\n    p2 = d1 ^ d2 ^ d3\n    p3 = d0 ^ d1\
      \ ^ d2 ^ d3 ^ p0 ^ p1 ^ p2\n    return (d0 << 7) | (d1 << 6) | (d2 << 5) | (d3\
      \ << 4) | (p0 << 3) | (p1 << 2) | (p2 << 1) | p3\n\ndef encode_bytes(data_bytes):\n\
      \    encoded = bytearray()\n    for b in data_bytes:\n        high_nibble =\
      \ (b >> 4) & 0x0F\n        low_nibble = b & 0x0F\n        encoded.append(encode_nibble(high_nibble))\n\
      \        encoded.append(encode_nibble(low_nibble))\n    return bytes(encoded)\n\
      \nclass blk(gr.basic_block):\n    \"\"\"Codec2 3200bps Audio Packetizer with\
      \ Hamming(8,4) FEC Encoding\"\"\"\n    def __init__(self):\n        gr.basic_block.__init__(\n\
      \            self,\n            name='Codec2 Audio Framer',\n            in_sig=[np.float32],\n\
      \            out_sig=[np.uint8]\n        )\n        self.codec2 = pycodec2.Codec2(3200)\n\
      \        self.samples_per_frame = 160  # 20ms at 8kHz\n        self.preamble_bytes\
      \ = bytes([0xE3, 0x8F, 0x30, 0x7A]) # 4 Bytes\n        self.seq_num = 0\n  \
      \      self.out_byte_queue = bytearray()\n        self.idle_byte = 0x55\n\n\
      \    def general_work(self, input_items, output_items):\n        in_audio =\
      \ input_items[0]\n        out = output_items[0]\n        n_in = len(in_audio)\n\
      \        n_out = len(out)\n        read_idx = 0\n\n        while (n_in - read_idx)\
      \ >= self.samples_per_frame:\n            chunk = in_audio[read_idx : read_idx\
      \ + self.samples_per_frame]\n            read_idx += self.samples_per_frame\n\
      \n            chunk_clipped = np.clip(chunk, -1.0, 1.0)\n            pcm16 =\
      \ (chunk_clipped * 32767.0).astype(np.int16)\n            encoded_payload =\
      \ self.codec2.encode(pcm16)\n            seq_bytes = int(self.seq_num & 0xFFFF).to_bytes(2,\
      \ byteorder='big')\n            self.seq_num = (self.seq_num + 1) & 0xFFFF\n\
      \            \n            raw_payload = seq_bytes + bytes(encoded_payload)\
      \ # 10 Bytes\n            fec_payload = encode_bytes(raw_payload)          #\
      \ 20 Bytes\n            \n            frame = self.preamble_bytes + fec_payload\
      \        # 24 Bytes Total\n            self.out_byte_queue.extend(frame)\n\n\
      \        self.consume(0, read_idx)\n\n        n_write = min(len(self.out_byte_queue),\
      \ n_out)\n        if n_write > 0:\n            out[:n_write] = np.frombuffer(self.out_byte_queue[:n_write],\
      \ dtype=np.uint8)\n            del self.out_byte_queue[:n_write]\n         \
      \   written = n_write\n        else:\n            written = 0\n\n        if\
      \ written < n_out:\n            out[written:n_out] = self.idle_byte\n      \
      \      written = n_out\n\n        return written"
    affinity: ''
    alias: ''
    comment: Packetizes PCM16 audio with sync preamble & sequence number
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Codec2 Audio Framer', 'blk', [], [('0', 'float', 1)], [('0', 'byte',
      1)], 'Codec2 3200bps Audio Packetizer with Hamming(8,4) FEC Encoding', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [304, 168.0]
    rotation: 0
    state: enabled

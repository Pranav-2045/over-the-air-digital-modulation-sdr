- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport struct\nimport\
      \ zlib\n\n# Synchronous PRBS whitening keystream (seed=42 matches BER setup)\n\
      _rng = np.random.RandomState(42)\nWHITENING_KEY = _rng.randint(0, 256, size=2048,\
      \ dtype=np.uint8)\n\nclass blk(gr.basic_block):\n    \"\"\"QPSK Repeating Text\
      \ Frame Generator with PRBS Whitening & CRC32\"\"\"\n    def __init__(self,\
      \ message=\"Hello USRP B210 QPSK Link!\"):\n        gr.basic_block.__init__(\n\
      \            self,\n            name='Text Frame Generator',\n            in_sig=[np.uint8],\n\
      \            out_sig=[np.uint8]\n        )\n        self.message = str(message)\n\
      \        self.seq_num = 0\n        \n        # 32-symbol preamble (same robust\
      \ sequence as BER setup)\n        self.preamble = np.array([3, 3, 3, 3, 3, 0,\
      \ 0, 3, 3, 0, 3, 0, 3, 3, 3, 3,\n                                  3, 3, 0,\
      \ 0, 3, 3, 0, 3, 0, 3, 3, 0, 0, 3, 0, 3], dtype=np.uint8)\n        \n      \
      \  self.current_frame = np.array([], dtype=np.uint8)\n        self.ptr = 0\n\
      \n    def set_message(self, message):\n        self.message = str(message)\n\
      \n    def bytes_to_symbols(self, data_bytes):\n        \"\"\"Convert bytes into\
      \ 2-bit QPSK symbols (4 symbols per byte, MSB first)\"\"\"\n        syms = []\n\
      \        for b in data_bytes:\n            syms.append((b >> 6) & 0x03)\n  \
      \          syms.append((b >> 4) & 0x03)\n            syms.append((b >> 2) &\
      \ 0x03)\n            syms.append(b & 0x03)\n        return np.array(syms, dtype=np.uint8)\n\
      \n    def pack_symbols_to_bytes(self, symbols):\n        \"\"\"Pack 4 2-bit\
      \ symbols into one 8-bit byte for Constellation Modulator\"\"\"\n        rem\
      \ = len(symbols) % 4\n        if rem != 0:\n            symbols = np.pad(symbols,\
      \ (0, 4 - rem), 'constant', constant_values=0)\n        \n        packed = np.zeros(len(symbols)\
      \ // 4, dtype=np.uint8)\n        for i in range(len(packed)):\n            packed[i]\
      \ = (int(symbols[4*i]) << 6) | (int(symbols[4*i+1]) << 4) | (int(symbols[4*i+2])\
      \ << 2) | int(symbols[4*i+3])\n        return packed\n\n    def build_packet(self):\n\
      \        \"\"\"Builds one framed packet: Preamble + Whitened(Header + Payload\
      \ + CRC32)\"\"\"\n        payload_text = f\"{self.message} [Pkt #{self.seq_num:05d}]\"\
      \n        payload_bytes = payload_text.encode('utf-8')\n        \n        #\
      \ Header (7 bytes):\n        # Magic (2B: 0x5A, 0xA5)\n        # Type (1B: 0x01\
      \ for repeating text)\n        # Seq Num (2B: uint16)\n        # Payload Len\
      \ (2B: uint16)\n        magic = 0x5AA5\n        pkt_type = 0x01\n        header_bytes\
      \ = struct.pack('>H B H H', magic, pkt_type, self.seq_num, len(payload_bytes))\n\
      \        \n        # CRC32 over unwhitened Header + Payload\n        crc = zlib.crc32(header_bytes\
      \ + payload_bytes) & 0xFFFFFFFF\n        crc_bytes = struct.pack('>I', crc)\n\
      \        \n        # Assemble raw data bytes\n        raw_data = bytearray(header_bytes\
      \ + payload_bytes + crc_bytes)\n        \n        # Whiten data bytes to eliminate\
      \ repetitive ASCII patterns & discrete CW tones\n        for i in range(len(raw_data)):\n\
      \            raw_data[i] ^= int(WHITENING_KEY[i % len(WHITENING_KEY)])\n   \
      \         \n        # Convert whitened data to symbols\n        data_syms =\
      \ self.bytes_to_symbols(raw_data)\n        \n        # Continuous streaming:\
      \ Preamble + Whitened Data (no dead unmodulated zeros!)\n        full_symbols\
      \ = np.concatenate([self.preamble, data_syms])\n        packed = self.pack_symbols_to_bytes(full_symbols)\n\
      \        \n        self.seq_num = (self.seq_num + 1) & 0xFFFF\n        return\
      \ packed\n\n    def general_work(self, input_items, output_items):\n       \
      \ in0 = input_items[0]\n        out = output_items[0]\n        n_out = len(out)\n\
      \        written = 0\n        read = min(len(in0), n_out)\n        \n      \
      \  while written < read:\n            if self.ptr >= len(self.current_frame):\n\
      \                self.current_frame = self.build_packet()\n                self.ptr\
      \ = 0\n                \n            rem = len(self.current_frame) - self.ptr\n\
      \            to_write = min(rem, read - written)\n            out[written:written+to_write]\
      \ = self.current_frame[self.ptr:self.ptr+to_write]\n            self.ptr +=\
      \ to_write\n            written += to_write\n            \n        self.consume(0,\
      \ read)\n        return written\n"
    affinity: ''
    alias: ''
    comment: QPSK Repeating Text Framer with PRBS Whitening & CRC32
    maxoutbuf: '0'
    minoutbuf: '0'
    message: msg_text
  states:
    _io_cache: ('Text Frame Generator', 'blk', [('message', "'Hello USRP B210 QPSK
      Link!'")], [('0', 'byte', 1)], [('0', 'byte', 1)], 'QPSK Repeating Text Frame
      Generator with PRBS Whitening & CRC32', ['message'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 128
    - 184.0
    rotation: 0
    state: enabled
